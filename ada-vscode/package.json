{
  "name": "ada-code-monorepo",
  "displayName": "Ada Code Monorepo",
  "description": "VSCode extension monorepo for Ada Code - chat and completions split into separate packages",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/luna-system/ada"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "watch": "pnpm -r watch",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "license": "CC0-1.0",
  "workspaces": [
    "packages/*"
  ]
}
