{
  "mcp.servers": {
    "ada": {
      "command": "uv",
      "args": ["run", "--directory", "/path/to/ada-v1/ada-mcp", "ada-mcp"],
      "env": {
        "ADA_BASE_URL": "http://localhost:8000"
      }
    }
  },
  "mcp.serverAutostart": true
}

// Usage in VSCodium:
// 1. Install MCP extension (if available)
// 2. Add this config to settings.json
// 3. Reload window (Ctrl+Shift+P -> "Reload Window")
// 4. Open Command Palette (Ctrl+Shift+P)
// 5. Search for "MCP: " commands to interact with Ada
//
// Available commands:
// - MCP: List Tools (shows ada_chat, ada_search_memory, etc.)
// - MCP: Call Tool (invoke Ada tools directly)
// - MCP: Chat with Ada (if extension supports chat interface)
