[Unit]
Description=Lumina Metrics - API Observability Platform
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/luna/Code/ada/lumina-metrics
EnvironmentFile=/home/luna/Code/ada/lumina-metrics/.env
ExecStart=/home/luna/Code/ada/lumina-metrics/.venv/bin/python -m lumina_metrics.main
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/luna/Code/ada/lumina-metrics/src
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
