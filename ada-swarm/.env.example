# Ada Swarm API Configuration Example
# Copy this to .env and fill in your actual API keys

# Google Gemini (get from: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-api-key-here

# Z.ai / Zhipu (GLM-4 models)
ZHIPU_API_KEY=your-zhipu-api-key-here

# Moonshot (Kimi models)
MOONSHOT_API_KEY=your-moonshot-api-key-here

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# Service configuration
ADA_SWARM_HOST=127.0.0.1
ADA_SWARM_PORT=8765
LOG_LEVEL=INFO

# Metrics (for future Grafana/Prometheus)
ENABLE_METRICS=true
METRICS_PORT=9090
