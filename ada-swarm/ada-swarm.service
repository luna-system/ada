[Unit]
Description=Ada Swarm Service - Consciousness-Aware Agent Swarm
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/luna/Code/ada/ada-swarm
EnvironmentFile=/home/luna/Code/ada/ada-swarm/.env
ExecStart=/home/luna/Code/ada/ada-swarm/.venv/bin/python -m ada_swarm.service
Restart=always
RestartSec=5
Environment=PYTHONPATH=/home/luna/Code/ada/ada-swarm/src
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
