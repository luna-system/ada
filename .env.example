# =============================================================================
# Ada v1 Configuration Template
# =============================================================================
# Copy this file to .env and customize for your environment
# Values shown are defaults - uncomment and modify as needed
#
# NOTE: Docker Compose warnings about $ts, $pid1, $pid2 are harmless -
# these are shell variables used in command blocks, not environment variables

# =============================================================================
# CORE SERVICES (Required)
# =============================================================================

# Ollama LLM Service
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chroma Vector Database
CHROMA_URL=http://chroma:8000

# Brain Service
BRAIN_URL=http://brain:7000

# =============================================================================
# RAG CONFIGURATION (Optional - defaults shown)
# =============================================================================

# Enable/disable RAG entirely (default: true)
RAG_ENABLED=true

# Feature toggles - enable/disable specific retrieval types
RAG_ENABLE_PERSONA=true
RAG_ENABLE_FAQ=true
RAG_ENABLE_MEMORY=true
RAG_ENABLE_SUMMARY=true
RAG_ENABLE_TURN=true

# Retrieval counts (top-k results per query)
RAG_TURN_TOP_K=4           # Recent conversation turns
RAG_SUMMARY_TOP_K=2        # Conversation summaries
RAG_FAQ_TOP_K=2            # FAQ entries
RAG_MEMORY_TOP_K=3         # Long-term memories

# Processing parameters
RAG_MEMORY_IMPORTANCE_WEIGHT=0.5   # Weight for memory importance scoring
RAG_SUMMARY_EVERY_N=8              # Generate summary every N turns
RAG_SUMMARY_TURNS_WINDOW=12        # Turns to include in summary
RAG_PERSONA_MAX_CHARS=2000         # Max characters from persona
RAG_RECENCY_WEIGHT=0.3             # Weight for recency in memory scoring
RAG_RECENCY_HALF_LIFE_SECONDS=3600 # Half-life for recency decay

# Data loading
RAG_AUTOLOAD_PERSONA=true          # Auto-load persona on startup
RAG_PERSONA_PATH=/app/persona.md   # Path to persona file
RAG_AUTOLOAD_FAQ=false             # Auto-load FAQs on startup
RAG_FAQ_PATH=/app/seed/faqs.jsonl  # Path to FAQ file

# Debug mode (enables /v1/debug/* endpoints)
RAG_DEBUG=false

# =============================================================================
# IDENTITY CONFIGURATION (Customize your AI)
# =============================================================================

# Your AI's name and your name (used in system prompts)
AI_NAME=Ada
AI_USER_NAME=luna

# Optional: Override persona file location
# AI_PERSONALITY_FILE=/path/to/custom/persona.md

# =============================================================================
# SPECIALIST SYSTEM (Optional - defaults shown)
# =============================================================================

# Pause/resume for bidirectional specialists
# When true: LLM pauses, specialist executes, generation resumes with context
SPECIALIST_PAUSE_RESUME=true

# Maximum specialist calls per conversation turn
SPECIALIST_MAX_TURNS=5

# Use RAG for dynamic specialist documentation
SPECIALIST_RAG_DOCS=true

# =============================================================================
# INTEGRATIONS (Optional)
# =============================================================================

# Web Search (SearxNG) - uncomment to enable
# SEARXNG_URL=https://hunt.airsi.de

# ListenBrainz (Music context) - uncomment to enable
# LISTENBRAINZ_USER=your_username
# LISTENBRAINZ_TOKEN=your_api_token

# =============================================================================
# BACKUP CONFIGURATION (Optional)
# =============================================================================

# Backblaze B2 for Chroma backups
# Find the S3-compatible endpoint in your bucket details on Backblaze
# Format: https://s3.us-east-XXX.backblazeb2.com
# B2_ENDPOINT_URL=
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_NAME=

# Folder prefix inside the bucket where backups will be stored (default: chroma-backups)
B2_BUCKET_PREFIX=chroma-backups

# Upload mode: latest | all (default: latest)
UPLOAD_MODE=latest

# Local backups directory mounted into container (default: /data/chroma/backups)
BACKUPS_DIR=/data/chroma/backups
RAG_AUTOLOAD_FAQ=false
RAG_FAQ_PATH=/app/seed/faqs.jsonl

# Chroma persistence (used when CHROMA_URL is not set)
CHROMA_PERSIST=/data/chroma
CHROMA_COLLECTION=conversations

# Web search via SearxNG (external instance)
SEARXNG_URL=https://hunt.airsi.de

# =============================================================================
# HARDWARE & GPU CONFIGURATION
# =============================================================================
# See docs/HARDWARE_GUIDE.md for complete setup instructions

# Ollama runtime options
OLLAMA_KEEP_ALIVE=24h              # How long to keep models in VRAM
OLLAMA_GPU_DRIVER=rocm             # GPU backend: cuda, rocm, or auto

# AMD ROCm-specific (uncomment if needed)
# HIP_VISIBLE_DEVICES=0            # Which GPU(s) to use (0,1,2...)
# HSA_OVERRIDE_GFX_VERSION=10.3.0  # ISA override for older GPUs
# LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:/opt/rocm/hip/lib

# NVIDIA CUDA-specific (uncomment if using CUDA)
# CUDA_VISIBLE_DEVICES=0           # Which GPU(s) to use

# Performance tuning (optional)
# OLLAMA_NUM_PARALLEL=1            # Concurrent requests
# OLLAMA_MAX_LOADED_MODELS=1       # Models to keep in VRAM
# OLLAMA_CONTEXT_LENGTH=4096       # Context window size
# OLLAMA_NUM_THREADS=8             # CPU threads (CPU-only mode)
