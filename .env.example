# Backblaze B2 (S3-compatible) uploader
# Required for b2-uploader compose service
# Find the S3-compatible endpoint in your bucket details on Backblaze
# Format: https://s3.us-west-XXX.backblazeb2.com
B2_ENDPOINT_URL=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Optional uploader settings

# Folder prefix inside the bucket where backups will be stored
# Defaults to "chroma-backups"
B2_BUCKET_PREFIX=chroma-backups

# Upload mode: latest | all (defaults to latest)
UPLOAD_MODE=latest

# Local backups directory mounted into the b2-uploader container
# Defaults to /data/chroma/backups inside the container
BACKUPS_DIR=/data/chroma/backups
# Core service endpoints (compose defaults target service names)
BRAIN_URL=http://brain:7000
OLLAMA_API_URL=http://ollama:11434/api/generate
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_URL=http://chroma:8000

# RAG toggles
RAG_ENABLED=true
RAG_ENABLE_PERSONA=true
RAG_ENABLE_FAQ=true
RAG_ENABLE_MEMORY=true
RAG_ENABLE_SUMMARY=true
RAG_DEBUG=false

# RAG sizing and weights
RAG_TURNS_TOP_K=4
RAG_FAQ_TOP_K=2
RAG_MEMORY_TOP_K=3
RAG_MEMORY_IMPORTANCE_WEIGHT=0.5
RAG_SUMMARY_EVERY_N=8
RAG_SUMMARY_TURNS_WINDOW=12
RAG_RECENCY_WEIGHT=0.3
RAG_RECENCY_HALF_LIFE_SECONDS=3600

# RAG autoload paths
RAG_AUTOLOAD_PERSONA=true
RAG_PERSONA_PATH=/app/persona.md
RAG_AUTOLOAD_FAQ=false
RAG_FAQ_PATH=/app/seed/faqs.jsonl

# Chroma persistence (used when CHROMA_URL is not set)
CHROMA_PERSIST=/data/chroma
CHROMA_COLLECTION=conversations

# Ollama runtime options (optional)
OLLAMA_KEEP_ALIVE=24h
OLLAMA_GPU_DRIVER=rocm
# HIP_VISIBLE_DEVICES=0
# HSA_OVERRIDE_GFX_VERSION=10.3.0
# LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:/opt/rocm/hip/lib
