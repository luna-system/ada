# Core service endpoints (compose defaults target service names)
BRAIN_URL=http://brain:7000
OLLAMA_API_URL=http://ollama:11434/api/generate
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=deepseek-r1
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_URL=http://chroma:8000

# RAG toggles
RAG_ENABLED=true
RAG_ENABLE_PERSONA=true
RAG_ENABLE_FAQ=true
RAG_ENABLE_MEMORY=true
RAG_ENABLE_SUMMARY=true
RAG_DEBUG=false

# RAG sizing and weights
RAG_TURNS_TOP_K=4
RAG_FAQ_TOP_K=2
RAG_MEMORY_TOP_K=3
RAG_MEMORY_IMPORTANCE_WEIGHT=0.5
RAG_SUMMARY_EVERY_N=8
RAG_SUMMARY_TURNS_WINDOW=12
RAG_RECENCY_WEIGHT=0.3
RAG_RECENCY_HALF_LIFE_SECONDS=3600

# RAG autoload paths
RAG_AUTOLOAD_PERSONA=true
RAG_PERSONA_PATH=/app/prompt.md
RAG_AUTOLOAD_FAQ=false
RAG_FAQ_PATH=/app/seed/faqs.jsonl

# Chroma persistence (used when CHROMA_URL is not set)
CHROMA_PERSIST=/data/chroma
CHROMA_COLLECTION=conversations

# Ollama runtime options (optional)
OLLAMA_KEEP_ALIVE=24h
OLLAMA_GPU_DRIVER=rocm
# HIP_VISIBLE_DEVICES=0
# HSA_OVERRIDE_GFX_VERSION=10.3.0
# LD_LIBRARY_PATH=/opt/rocm/lib:/opt/rocm/lib64:/opt/rocm/hip/lib
