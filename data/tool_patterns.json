{
  "version": "1.1.0",
  "description": "Tool activation patterns for pre-execution matching (Tier 1 - Anticipatory/Reflex)",
  "patterns": [
    {
      "tool_name": "datetime",
      "description": "Current date and time queries",
      "activation_patterns": [
        {
          "regex": "(?:what(?:'s|\\s+is)?\\s+(?:the\\s+)?(?:current\\s+)?time|what\\s+time\\s+is\\s+it)",
          "confidence_base": 0.95,
          "param_extraction": {}
        },
        {
          "regex": "(?:what(?:'s|\\s+is)?\\s+(?:the\\s+)?(?:current\\s+)?date|what\\s+day\\s+is\\s+(?:it|today))",
          "confidence_base": 0.95,
          "param_extraction": {}
        },
        {
          "regex": "(?:today(?:'s)?\\s+date|current\\s+(?:date|time|datetime))",
          "confidence_base": 0.9,
          "param_extraction": {}
        }
      ],
      "negative_patterns": []
    },
    {
      "tool_name": "codebase",
      "description": "Ada's own codebase lookup",
      "activation_patterns": [
        {
          "regex": "(?:how does|what does|show me|look up|find|explain)\\s+(?:the\\s+)?([a-z_]+)\\s+(?:work|function|class|method|code|implementation)",
          "confidence_base": 0.9,
          "param_extraction": {"query": "group1"}
        },
        {
          "regex": "(?:code for|implementation of|definition of|source code for)\\s+([a-z_]+)",
          "confidence_base": 0.95,
          "param_extraction": {"query": "group1"}
        },
        {
          "regex": "(?:where is|show|find)\\s+([A-Z][a-zA-Z]+)(?:\\s+class)?",
          "confidence_base": 0.85,
          "param_extraction": {"query": "group1"}
        }
      ],
      "negative_patterns": [
        "(?:think|believe|feel|opinion|interesting) (?:about|that)",
        "(?:generally|usually|typically)",
        "(?:concept of|idea of)"
      ]
    },
    {
      "tool_name": "web_search",
      "description": "External web search for current information",
      "activation_patterns": [
        {
          "regex": "(?:search|look up|find).*?(?:web|internet|online)",
          "confidence_base": 0.95,
          "param_extraction": {"query": "group0"}
        },
        {
          "regex": "(?:what's|what is|whats)\\s+happening\\s+(?:with|to|about)\\s+(.+?)(?:\\?|$)",
          "confidence_base": 0.85,
          "param_extraction": {"query": "group1"}
        },
        {
          "regex": "(?:what's|what is|whats)\\s+(?:the\\s+)?(?:latest|current|recent|news)\\s+(?:on|about|with)\\s+(.+?)(?:\\?|$)",
          "confidence_base": 0.85,
          "param_extraction": {"query": "group1"}
        },
        {
          "regex": "(?:weather|temperature)\\s+(?:in|at|for)\\s+([A-Z][a-zA-Z\\s]+)",
          "confidence_base": 0.9,
          "param_extraction": {"query": "group0"}
        }
      ],
      "negative_patterns": []
    },
    {
      "tool_name": "wiki_lookup",
      "description": "Wikipedia and fandom wiki lookups",
      "activation_patterns": [
        {
          "regex": "(?:who is|what is|tell me about)\\s+([A-Z][a-zA-Z\\s]+?)\\s+from\\s+(BFDI|BFB|TPOT|the show)",
          "confidence_base": 0.95,
          "param_extraction": {"page": "group1", "wiki": "bfdi"}
        },
        {
          "regex": "(?:who is|what is|tell me about)\\s+([A-Z][a-zA-Z\\s]+?)(?:\\?|$)",
          "confidence_base": 0.85,
          "param_extraction": {"page": "group1", "wiki": "wikipedia"}
        },
        {
          "regex": "look up\\s+([A-Z][a-zA-Z\\s]+?)\\s+on\\s+(?:the\\s+)?(?:wiki|wikipedia)",
          "confidence_base": 0.95,
          "param_extraction": {"page": "group1", "wiki": "wikipedia"}
        },
        {
          "regex": "look up\\s+([A-Z][a-zA-Z\\s]+?)\\s+on\\s+(?:the\\s+)?(?:Object Show|BFDI)",
          "confidence_base": 0.95,
          "param_extraction": {"page": "group1", "wiki": "bfdi"}
        }
      ],
      "negative_patterns": [
        "(?:in my code|in Ada|in the codebase)"
      ]
    }
  ]
}
