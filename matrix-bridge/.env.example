# Matrix Bridge Configuration
# Add these to your .env file

# Matrix homeserver URL
MATRIX_HOMESERVER=https://matrix.yourdomain.com

# Bot user ID (full Matrix ID)
MATRIX_USER_ID=@ada-bot:yourdomain.com

# Access token (recommended - get from login response)
MATRIX_ACCESS_TOKEN=syt_your_access_token_here

# Or password (less secure, not recommended for production)
# MATRIX_PASSWORD=your_bot_password

# Optional: Bot display name (defaults to "Ada [Bot]")
# DISPLAY_NAME=Ada [Bot]

# Optional: Avatar URL (MXC URL from Matrix media upload)
# AVATAR_URL=mxc://yourdomain.com/media_id

# Optional: Behavior overrides
# SEND_INTRO_ON_JOIN=true
# AUTO_ACCEPT_INVITES=true
# TYPING_INDICATOR=true
# RESPOND_TO_MENTIONS=true
# RESPOND_TO_DMS=true
# MAX_CONTEXT_MESSAGES=10

# Optional: Privacy settings
# ALLOW_PRIVACY_OPT_OUT=true
# STORE_IN_RAG=true
# DATA_RETENTION_DAYS=90

# Optional: Room filters
# ALLOWED_ROOMS=!roomid1:domain.com,!roomid2:domain.com
# NEVER_JOIN_ROOMS=!private-room:domain.com

# Optional: Logging
# LOG_LEVEL=INFO
