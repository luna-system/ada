server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve service names (e.g., brain) at runtime so container IP changes don't break proxying
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $brain_upstream ${BRAIN_URL};

    # Serve Sphinx documentation (must come before / to avoid SPA catch-all)
    location /docs/ {
        alias /usr/share/nginx/html/docs/;
        index index.html;
        try_files $uri $uri/ $uri.html =404;
    }

    # Redirect /docs to /docs/
    location = /docs {
        return 301 /docs/;
    }

    # Serve the SPA and fall back to index.html for client routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Health check: map /api/health -> /v1/healthz
    location = /api/health {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass $brain_upstream/v1/healthz;
    }

    # Proxy API calls to the brain service, rewriting /api/* -> /v1/*
    location /api/ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off; # Required for SSE
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $brain_upstream;
    }
}
