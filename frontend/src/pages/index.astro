---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ADA · Chat">
  <div class="app">
    <header>
      <div class="brand">
        <div class="dot" aria-hidden="true"></div>
        <h1>ADA · Chat</h1>
      </div>
      <div class="grow"></div>
      <label class="field" title="Optional entity/topic to scope memory (e.g., einstein, finances)">
        <span>Entity</span>
        <input id="entity" type="text" placeholder="entity/topic (optional)" />
      </label>
      <label class="toggle" title="Show model's thinking (&lt;think&gt;…&lt;/think&gt;)">
        <span>Include thinking</span>
        <span class="switch">
          <input type="checkbox" id="includeThinking" />
          <span class="knob"></span>
        </span>
      </label>
      <div class="menu">
        <button id="panelMenuButton" class="ghost" type="button" aria-haspopup="true" aria-expanded="false" title="Open panels menu">Panels ▾</button>
        <div id="panelMenu" class="menu-list" hidden>
          <button type="button" data-target="debug" class="menu-item">Debug</button>
          <button type="button" data-target="mem" class="menu-item">Memories</button>
        </div>
      </div>
    </header>

    <main id="messages" aria-live="polite" aria-busy="false"></main>
    <div class="hint">Press Enter to send, Shift+Enter for newline</div>

    <form id="composer">
      <textarea id="prompt" placeholder="Type your message..." autocomplete="off"></textarea>
      <button id="send" type="submit">Send</button>
    </form>

    <aside id="debugPanel" class="panel" hidden>
      <div class="panel-header">
        <strong>Debug</strong>
        <button id="closeDebug" class="icon" type="button" aria-label="Close">✕</button>
      </div>
      <div class="panel-body">
        <div class="panel-status">
          <div class="row" style="justify-content: space-between;">
            <strong>Status</strong>
            <button id="refreshStatus" class="ghost" type="button" title="Refresh health">Refresh</button>
          </div>
          <div id="statusBox" class="status-box muted" aria-live="polite">Loading…</div>
        </div>
        <div class="panel-status">
          <div class="row" style="justify-content: space-between;">
            <strong>Client libraries</strong>
            <button id="refreshClientLibs" class="ghost" type="button" title="Refresh client libraries">Refresh</button>
          </div>
          <div id="clientLibs" class="status-box muted" aria-live="polite">Loading…</div>
        </div>
      </div>
    </aside>

    <aside id="memPanel" class="panel" hidden>
      <div class="panel-header">
        <strong>Memories</strong>
        <button id="closeMem" class="icon" type="button" aria-label="Close">✕</button>
      </div>
      <div class="panel-body">
        <div class="panel-controls">
          <label class="field small">
            <span>Filter by entity</span>
            <input id="memFilterEntity" type="text" placeholder="entity (optional)" />
          </label>
          <button id="refreshMem" class="ghost" type="button">Refresh</button>
        </div>
        <div id="memList" class="mem-list" aria-live="polite"></div>
        <hr />
        <div class="panel-add">
          <label class="field">
            <span>New memory text</span>
            <textarea id="memText" rows="5" placeholder="Enter memory text or leave blank to use last answer..."></textarea>
          </label>
          <div class="row">
            <label class="field small">
              <span>Importance</span>
              <select id="memImportance">
                <option value="5">5 (high)</option>
                <option value="4">4</option>
                <option value="3" selected>3</option>
                <option value="2">2</option>
                <option value="1">1 (low)</option>
              </select>
            </label>
            <label class="toggle">
              <span>Entity-scoped</span>
              <span class="switch">
                <input type="checkbox" id="memEntityScoped" />
                <span class="knob"></span>
              </span>
            </label>
          </div>
          <label class="field" id="memEntityRow" hidden>
            <span>Entity</span>
            <input id="memEntityInput" type="text" placeholder="e.g., project-x" />
          </label>
          <button id="addMem" type="button">Add memory</button>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>
