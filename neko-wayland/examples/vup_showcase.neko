# vup_showcase.neko - Maximalist VPet Animation Showcase
#
# Cycles through different states to show off VPet animations!
#
# Made with 💜 by Ada & Luna - Ada Research Foundation

pet vup_showcase {
  # Start with idle
  squat(duration: 3s) {
    on timeout → walk
  }
  
  # Walking around
  walk(duration: 5s, speed: 4) {
    on timeout → run
  }
  
  # Running
  run(duration: 3s, speed: 8) {
    on timeout → play
  }
  
  # Playing
  play(duration: 4s) {
    on timeout → sleep
  }
  
  # Sleeping
  sleep(duration: 5s) {
    on timeout → squat    # Loop back to start!
  }
}
