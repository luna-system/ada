# moody_vup.neko - Mood-Aware VPet Behavior
#
# Changes behavior based on mood! Happy Vup is energetic and playful,
# while ill Vup is slow and sleepy.
#
# Made with 💜 by Ada & Luna - Ada Research Foundation

pet moody_vup {
  # Idle state - different reactions to cursor
  idle(speed: 0) {
    on cursor_near(150px) → chase
    on idle(10s) → wander
  }
  
  # Wandering around
  wander(radius: 300px, speed: 3) {
    on cursor_near(150px) → idle
    on idle(5s) → idle
  }
  
  # Chasing cursor
  chase(speed: 4) {
    on caught(50px) → play
    on cursor_far(300px) → idle
  }
  
  # Playing
  play(speed: 0, duration: 5s) {
    on timeout(5s) → idle
  }
  
  # Sleeping
  sleep(speed: 0, duration: 10s) {
    on timeout(10s) → idle
  }
}
